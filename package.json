{
	"name": "webext-storage-cache",
	"version": "7.0.0-0",
	"description": "Cache values in your Web Extension and clear them on expiration. Also includes a memoize-like API to cache any function results automatically.",
	"keywords": [
		"await",
		"background page",
		"browser",
		"cache",
		"chrome",
		"content script",
		"expirating",
		"extension",
		"firefox",
		"safari",
		"memoize",
		"memoization",
		"options page",
		"promises",
		"self-cleaning",
		"temporary",
		"web-ext",
		"webext"
	],
	"repository": "fregante/webext-storage-cache",
	"funding": "https://github.com/sponsors/fregante",
	"license": "MIT",
	"author": "Federico Brigante <me@fregante.com> (https://fregante.com)",
	"type": "module",
	"exports": "./distribution/index.js",
	"types": "./distribution/index.d.ts",
	"files": [
		"distribution/index.js",
		"distribution/index.d.ts",
		"distribution/shared.js",
		"distribution/shared.d.ts",
		"distribution/cached-value.js",
		"distribution/cached-value.d.ts",
		"distribution/cached-function.js",
		"distribution/cached-function.d.ts"
	],
	"scripts": {
		"build": "tsc",
		"prepack": "tsc --sourceMap false",
		"test": "tsc && tsd && vitest run && xo",
		"watch": "tsc --watch"
	},
	"dependencies": {
		"@sindresorhus/to-milliseconds": "^2.0.0",
		"type-fest": "^5.8.0",
		"webext-detect": "^6.0.0"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/chrome": "0.2.5",
		"tsd": "^0.33.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10",
		"xo": "^4.0.0"
	},
	"engines": {
		"node": ">=18"
	},
	"tsd": {
		"directory": "source"
	}
}
