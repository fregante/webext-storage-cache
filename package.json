{
	"name": "webext-storage-cache",
	"version": "7.0.0",
	"description": "Cache values in your Web Extension and clear them on expiration. Also includes a memoize-like API to cache any function results automatically.",
	"license": "MIT",
	"repository": "fregante/webext-storage-cache",
	"funding": "https://github.com/sponsors/fregante",
	"author": "Federico Brigante <me@fregante.com> (https://fregante.com)",
	"type": "module",
	"exports": {
		"types": "./distribution/index.d.ts",
		"default": "./distribution/index.js"
	},
	"sideEffects": [
		"./distribution/index.js"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc",
		"prepack": "tsc --sourceMap false",
		"test": "tsc && tsd --typings distribution/index.d.ts && vitest run && xo",
		"watch": "tsc --watch"
	},
	"files": [
		"distribution"
	],
	"keywords": [
		"await",
		"background page",
		"browser",
		"cache",
		"chrome",
		"content script",
		"expirating",
		"extension",
		"firefox",
		"safari",
		"memoize",
		"memoization",
		"options page",
		"promises",
		"self-cleaning",
		"temporary",
		"web-ext",
		"webext"
	],
	"dependencies": {
		"@sindresorhus/to-milliseconds": "^2.0.0",
		"type-fest": "^5.10.0",
		"webext-detect": "^6.0.0"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/chrome": "^0.3.6",
		"tsd": "^0.33.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5",
		"xo": "^5.0.1"
	},
	"tsd": {
		"directory": "source"
	}
}
